{
  "name": "licenta-demo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend for parametric agricultural insurance demo",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "oracle": "tsx src/oracle/oracleRunner.ts",
    "payout-worker": "tsx src/workers/payoutWorker.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "seed:policies": "tsx src/scripts/seedDemoPolicies.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
